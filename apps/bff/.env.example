# ---- LIVE mode (all optional; without them every AI endpoint answers {fallback:true} and the app shows DEMO answers) ----
GCP_PROJECT=certis-mozart-frontline
GCP_LOCATION=global                 # GE engine location (global | us | eu)
VERTEX_LOCATION=asia-southeast1     # Gemini (GEAP agents) region
GE_ENGINE_ID=canopy-mall-engine     # one engine per site; data stores: SOPs, manuals, notices, incident summaries
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LITE_MODEL=gemini-2.5-flash-lite

# Workforce Identity Federation (officer IdP token -> STS -> per-user access token)
WIF_AUDIENCE=//iam.googleapis.com/locations/global/workforcePools/certis-officers/providers/certis-idp
WIF_SUBJECT_TOKEN_TYPE=urn:ietf:params:oauth:token-type:id_token

# Server-side token for GEAP calls in development only (never ship to devices). In production the per-officer WIF token is used.
GOOGLE_ACCESS_TOKEN=

# Model Armor (prompt + response screening)
MODEL_ARMOR_TEMPLATE=projects/certis-mozart-frontline/locations/asia-southeast1/templates/frontline-default

# Mozart action layer (writes only after an officer confirmation)
MOZART_API_URL=
MOZART_API_KEY=

# Allowed browser origin for the Expo web build
CORS_ORIGIN=*

# In-house HR system (leave, claims, roster, licences). Writes only after an officer confirmation.
HR_API_URL=
HR_API_KEY=
